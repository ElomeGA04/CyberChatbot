<Window x:Class="CyberChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="720"
        Width="1000"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2D2D2D"
                Padding="15"
                CornerRadius="8"
                Margin="0,0,0,12">
            <StackPanel>
                <Viewbox MaxHeight="90"
                         Stretch="Uniform">
                    <TextBlock x:Name="AsciiArtTextBlock"
                               FontFamily="Consolas"
                               Foreground="#FF6B6B"
                               FontWeight="Bold"
                               FontSize="10"
                               TextAlignment="Center"
                               xml:space="preserve"/>
                </Viewbox>

                <TextBlock Text="Your personal Cyber Safety Assistant"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
            
        </Border>

        <Border Grid.Row="1"
                Background="#252525"
                CornerRadius="8"
                Margin="0,0,0,12"
                Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChatStackPanel"/>

            </ScrollViewer>
            
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputBox"
                     Grid.Column="0"
                     Height="45"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Padding="12"
                     Background="#3D3D3D"
                     Foreground="White"
                     CaretBrush="#ff6B6B"
                     BorderBrush="#ff6B6B"
                     BorderThickness="2"
                     KeyDown="UserInputBox_KeyDown"/>
            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Content="SEND"
                    Height="45"
                    Width="100"
                    Margin="10,0,200,0"
                    FontWeight="Bold"
                    FontSize="14"
                    Background="#ff6B6B"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
            <Button x:Name="ExitButton"
                    Grid.Column="2"
                    Content="EXIT"
                    Height="45"
                    Width="100"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    FontSize="14"
                    Background="#444444"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ExitButton_Click"/>
        </Grid>

    </Grid>
</Window>
