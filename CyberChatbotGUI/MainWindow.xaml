<Window x:Class="CyberChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="720"
        Width="1000"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid Margin="10">
        <!--TabControl is used to hold the applications different features -->
        <TabControl x:Name="MainTabControl"
                    Background="Transparent"
                    BorderThickness="0">
            
            <!-- TAB 1: Existing chat functionality -->
            <TabItem Header="Chat" 
                     Foreground="Black"
                     FontWeight="Bold">
                <Grid Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    
                    <!--ASCII Art Header -->
                    <Border Grid.Row="0"
                            Background="#2D2D2D"
                            Padding="15"
                            CornerRadius="8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="AsciiArtTextBlock"
                                       FontFamily="Consolas"
                                       Foreground="#FF6B6B"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Your Personal Cyber Safety Assistant"
                                       Foreground="#AAAAAA"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!--Chat History -->
                    <Border Grid.Row="1"
                            Background="#252525"
                            CornerRadius="8"
                            Margin="0,0,0,12"
                            Padding="10">
                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatStackPanel"/>
                        </ScrollViewer>
                    </Border>
                    
                    <!--User Input Area -->
                    <DockPanel Grid.Row="2"
                               LastChildFill="True">
                        <Button x:Name="ExitButton"
                                DockPanel.Dock="Right"
                                Content="EXIT"
                                Height="45"
                                Width="80"
                                Margin="10,0,0,0"
                                FontWeight="Bold"
                                Background="#444444"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ExitButton_Click"/>

                        <Button x:Name="SendButton"
                                DockPanel.Dock="Right"
                                Content="SEND"
                                Height="45"
                                Width="100"
                                Margin="10,0,0,0"
                                FontWeight="Bold"
                                Background="#FF6B6B"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SendButton_Click"/>

                        <TextBox x:Name="UserInputBox"
                                 Height="45"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 Background="#3D3D3D"
                                 Foreground="White"
                                 CaretBrush="#FF6B6B"
                                 BorderBrush="#FF6B6B"
                                 BorderThickness="2"
                                 KeyDown="UserInputBox_KeyDown"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            
            <!--TAB 2: Task Assistant functionality -->
            <TabItem Header="Task Assistant"
                     Foreground="Black"
                     FontWeight="Bold">
                <Grid Background="#1E1E1E"
                      Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#2D2D2D"
                            Padding="15"
                            CornerRadius="8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Add a Cybersecurity Task"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Task Title:"
                                       Foreground="LightGray"
                                       Margin="0,5,0,2"/>
                            <TextBox x:Name="TaskTitleBox"
                                     Height="30"
                                     Background="#3D3D3D"
                                     Foreground="White"
                                     BorderBrush="#FF6B6B"/>
                            <TextBlock Text="Description:"
                                       Foreground="LightGray"
                                       Margin="0,1,0,2"/>
                            <TextBox x:Name="TaskDescBox"
                                     Height="30"
                                     Background="#3D3D3D"
                                     Foreground="White"
                                     BorderBrush="#FF6B6B"/>
                            <TextBlock Text="Reminder (Days from now, e.g., '3'):"
                                       Foreground="LightGray"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TaskReminderBox"
                                     Height="30"
                                     Width="200"
                                     HorizontalAlignment="Left"
                                     Background="#3D3D3D"
                                     Foreground="White"
                                     BorderBrush="#FF6B6B"/>
                            <Button x:Name="AddTaskButton"
                                    Content="Add Task"
                                    Height="35"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="AddTaskButton_Click"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="TasksDataGrid"
                              Background="#252525"
                              Foreground="White"
                              RowBackground="#2D2D2D"
                              AlternatingRowBackground="#333333"
                              HorizontalGridLinesBrush="#444444"
                              VerticalGridLinesBrush="#444444"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Reminder"
                                                Binding="{Binding ReminderDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Done"
                                                Binding="{Binding IsCompleted}"
                                                Width="60"/>
                            <DataGridTemplateColumn Header="Actions"
                                                Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✔"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2"
                                                    Background="#4CAF50"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"
                                                    Click="MarkCompleteButton_Click"/>
                                            <Button Content="❌"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2"
                                                    Background="#FF6B6B"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"
                                                    Click="DeleteTaskButton_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!--TAB 3: Cybersecurity quiz functionality -->
            <TabItem Header="Cybersecurity Quiz"
                     Foreground="Black"
                     FontWeight="Bold">
                <Grid Background="#1E1E1E">
                    <TextBlock Text="Cybersecurity Quiz will go here"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"/>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>

    